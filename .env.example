# Supabase (Project Settings -> API Keys). The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Zoho API Console (https://api-console.zoho.in) -> Server-based Application.
# Authorized redirect URI must be: <APP_URL>/api/oauth/zoho/callback
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=

# Encrypts Zoho tokens at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Public origin of this app. Optional on Vercel (falls back to the production URL).
APP_URL=http://localhost:3000

# --- Optional: scripts -------------------------------------------------------
# npm run test:connector
MCP_URL=http://localhost:3000/api/mcp
MCP_API_KEY=

# npm run seed (one-off Self Client grant with write scopes; see docs/TESTING.md A10)
ZOHO_SELF_CLIENT_ID=
ZOHO_SELF_CLIENT_SECRET=
ZOHO_SELF_CLIENT_CODE=
